source "https://rubygems.org"

# Gem que replica exactamente el entorno de build de GitHub Pages.
# Hace que `bundle exec jekyll serve` en local produzca el mismo
# resultado que el deploy en github.io.
gem "github-pages", group: :jekyll_plugins

# Necesario para resolver el remote_theme declarado en _config.yml.
gem "jekyll-remote-theme"
